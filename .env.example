# Salin file ini jadi .env lalu isi. Jangan commit .env!
# Ambil dari https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Opsional. Default: http://localhost:<PORT>/oauth/callback
# Nilai ini harus sama persis dengan "App Redirect URL" di pengaturan app MAL.
# MAL_REDIRECT_URI=http://localhost:3000/oauth/callback

PORT=3000
